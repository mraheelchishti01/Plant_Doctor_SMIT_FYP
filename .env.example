# ============================================================
# Backend Environment Configuration (FastAPI / Uvicorn)
# ============================================================
PORT=8000
CORS_ORIGINS=*

# Optional: OpenAI API Key for AI Agronomist Consultation
OPENAI_API_KEY=

# ============================================================
# Frontend Environment Configuration (Vercel / Vite)
# ============================================================
# For local development: http://127.0.0.1:8000
# For Vercel production: Set to your live cloud backend URL (e.g., https://potato-doctor-ai-api.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8000
